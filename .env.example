# Render Web Service (the backend repository root is the project root).
# Render sets PORT=10000 by default and provides RENDER_EXTERNAL_URL at runtime.
PORT=10000
# Bind all interfaces on Render; set HOST=127.0.0.1 for local-only development.
HOST=0.0.0.0
NODE_ENV=production

# Secrets: set these in Render's Environment dashboard; never commit real values.
MONGODB_URI=mongodb+srv://<atlas-user>:<url-encoded-password>@<atlas-cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-bytes
JWT_EXPIRES_IN=7d

# RDK X5 stream assignment API (current Tailscale IP; Render reaches it through the proxy below).
RDK_STREAM_BASE_URL=http://100.90.42.36:5001
RDK_CAMERA_TIMEOUT_MS=12000
# Assignment/token requests may need longer than camera status requests over the Render proxy.
RDK_ASSIGNMENT_TIMEOUT_MS=30000
# RDK tokens remain valid until an assignment changes; cache briefly and invalidate on admin reassignment.
RDK_STREAM_TOKEN_CACHE_MS=300000
RDK_STREAM_ADMIN_KEY=replace-with-the-same-secret-as-RDK-main_service-ADMIN_API_KEY
# Required on Render: private Tailscale HTTP-proxy service host and port (typically :1055).
RDK_HTTP_PROXY_HOSTPORT=<render-private-tailscale-proxy-host>:1055
# Alternatively use RDK_HTTP_PROXY_URL=http://<proxy-host>:1055 instead of HOSTPORT.
# RDK_HTTP_PROXY_URL=

# Allow the Vercel production site and the current Preview deployment while testing.
# Remove the Preview entries after production cutover; do not add a trailing slash.
FRONTEND_ORIGIN=https://wave-root-client.vercel.app
FRONTEND_ORIGINS=https://wave-root-client.vercel.app,https://wave-root-client-git-codex-fronten-dc4920-hyunsung213s-projects.vercel.app,https://wave-root-client-dcspatugx-hyunsung213s-projects.vercel.app

# Leave unset on Render: it automatically supplies RENDER_EXTERNAL_URL.
# PUBLIC_BASE_URL=https://<your-service>.onrender.com
RDK_API_KEY=replace-with-the-same-secret-as-RDKx5-RDK_API_KEY
RDK_SENSOR_STALE_MS=180000

# Raspberry Pi Y-Farm irrigation: remain DISABLED until the Pi nozzle map and
# pump flow are measured, the single-GPIO-owner service is reconciled, and an
# operator explicitly arms the local agent. Never reuse RDK_API_KEY here.
PI_IRRIGATION_ENABLED=false
# Keep false until field nozzle/pump calibration and emergency-stop tests pass.
PI_IRRIGATION_ARMED=false
PI_IRRIGATION_DEVICE_ID=y-farm-pi-1
PI_IRRIGATION_API_KEY=replace-with-a-different-random-secret-at-least-32-characters

# Y-Farm Pi status/sensor proxy. The Pi serial bridge samples ESP32 about every
# 2 seconds; this backend reads the latest status on demand. Sensor values are
# shared by the Y-Farm bed, and soil moisture is the raw 0..4095 ADC reading.
PI_CONTROL_ENABLED=false
PI_CONTROL_BASE_URL=http://<pi-tailscale-ip>:8765
PI_CONTROL_TIMEOUT_MS=5000
PI_SENSOR_STALE_SECONDS=7
# Keep false until you explicitly want an admin action to move the physical servo.
PI_SERVO_CONTROL_ENABLED=false
# Optional dedicated proxy. If omitted, the backend reuses RDK_HTTP_PROXY_URL.
# PI_HTTP_PROXY_URL=http://<tailscale-http-proxy-host>:1055

# Y-Farm streaming is also off until the Pi gateway/service and camera URLs are installed.
# PI control and streaming use PI_HTTP_PROXY_URL when set, otherwise RDK_HTTP_PROXY_URL.
PI_STREAM_ENABLED=false
PI_STREAM_GATEWAY_ID=y-farm-pi-1
PI_STREAM_BASE_URL=http://<pi-tailscale-ip>:8767
PI_STREAM_HMAC_SECRET=replace-with-a-distinct-random-secret-at-least-32-characters

# Mount a Render Persistent Disk at /var/data to retain uploaded event images.
EVENT_UPLOAD_DIR=/var/data/uploads/events

# Admin web login; use a unique ID/password (do not reuse a camera or Wi-Fi password).
ADMIN_ID=replace-with-a-unique-admin-id
ADMIN_PWD=replace-with-a-unique-strong-admin-password

# Account-transfer checkout. Paid orders stay disabled until all three real values are configured.
DEPOSIT_BANK_NAME=replace-with-bank-name
DEPOSIT_ACCOUNT_NUMBER=replace-with-account-number
DEPOSIT_ACCOUNT_HOLDER=replace-with-account-holder

# Optional Discord webhook for signup, order, and camera interruption alerts.
# Create an incoming webhook in a private Discord channel; do not commit the URL.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
