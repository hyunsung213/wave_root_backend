PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# RDK X5 Flask gateway address. Used only by GET /api/web/plants/:plantId/current.
RDK_CURRENT_API_URL=http://[RDK_X5_IP]:5000/api/rdk/current
# RDK X5 stream origin. Each plant streamingPort replaces the port in this URL.
# A path is optional and is preserved, for example: http://[RDK_X5_IP]/video_feed
RDK_STREAMING_BASE_URL=http://[RDK_X5_IP]/video_feed
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:5000
