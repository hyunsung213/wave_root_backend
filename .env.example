# Render Web Service (the backend repository root is the project root).
# Render sets PORT=10000 by default and provides RENDER_EXTERNAL_URL at runtime.
PORT=10000
NODE_ENV=production

# Secrets: set these in Render's Environment dashboard; never commit real values.
MONGODB_URI=mongodb+srv://<atlas-user>:<url-encoded-password>@<atlas-cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-bytes
JWT_EXPIRES_IN=7d

# RDK X5 stream assignment API (current Tailscale IP; Render reaches it through the proxy below).
RDK_STREAM_BASE_URL=http://100.90.42.36:5001
RDK_CAMERA_TIMEOUT_MS=12000
RDK_STREAM_ADMIN_KEY=replace-with-the-same-secret-as-RDK-main_service-ADMIN_API_KEY
# Required on Render: private Tailscale HTTP-proxy service host and port (typically :1055).
RDK_HTTP_PROXY_HOSTPORT=<render-private-tailscale-proxy-host>:1055
# Alternatively use RDK_HTTP_PROXY_URL=http://<proxy-host>:1055 instead of HOSTPORT.
# RDK_HTTP_PROXY_URL=

# Allow the Vercel production site and the current Preview deployment while testing.
# Remove the Preview entries after production cutover; do not add a trailing slash.
FRONTEND_ORIGIN=https://wave-root-client.vercel.app
FRONTEND_ORIGINS=https://wave-root-client.vercel.app,https://wave-root-client-git-codex-fronten-dc4920-hyunsung213s-projects.vercel.app,https://wave-root-client-dcspatugx-hyunsung213s-projects.vercel.app

# Leave unset on Render: it automatically supplies RENDER_EXTERNAL_URL.
# PUBLIC_BASE_URL=https://<your-service>.onrender.com
RDK_API_KEY=replace-with-the-same-secret-as-RDKx5-RDK_API_KEY
RDK_SENSOR_STALE_MS=180000

# Mount a Render Persistent Disk at /var/data to retain uploaded event images.
EVENT_UPLOAD_DIR=/var/data/uploads/events

# Admin web login; use a unique ID/password (do not reuse a camera or Wi-Fi password).
ADMIN_ID=replace-with-a-unique-admin-id
ADMIN_PWD=replace-with-a-unique-strong-admin-password

# Account-transfer checkout. Paid orders stay disabled until all three real values are configured.
DEPOSIT_BANK_NAME=replace-with-bank-name
DEPOSIT_ACCOUNT_NUMBER=replace-with-account-number
DEPOSIT_ACCOUNT_HOLDER=replace-with-account-holder
